# ==============================================================================
# Medicina Catalogue Backend - Environment Variables Template
#
# INSTRUCTIONS:
# - Copy this template to .env.development for local development.
# - Copy this template to .env.production for production VPS deployment.
# - NEVER commit .env, .env.development, or .env.production to version control.
# ==============================================================================

# Server Environment & Network
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Database (PostgreSQL / Neon)
# In production, use your Neon pooled connection string with SSL mode required
DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/medicina_db?sslmode=require

# Authentication & JWT
# JWT_SECRET must be at least 32 characters long
JWT_SECRET=replace-with-a-secure-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=15m

# Cloudflare R2 Storage (S3-Compatible Object Storage)
# Required for medicine image and profile image uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://images.yourdomain.com
